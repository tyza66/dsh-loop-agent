{
  "name": "@tyza66/dsh-loop-agent",
  "description": "DSH headless profile bundle that keeps the same session alive across rounds: after each final answer, automatically inject a user-configurable continuation prompt and loop forever (Ctrl-C to stop).",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyza66/dsh-loop-agent.git"
  },
  "homepage": "https://github.com/tyza66/dsh-loop-agent#readme",
  "bugs": {
    "url": "https://github.com/tyza66/dsh-loop-agent/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent",
    "loop",
    "headless"
  ]
}
