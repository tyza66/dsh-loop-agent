{
  "name": "@tyza66/dsh-loop-agent",
  "description": "DSH web profile bundle that turns every agent into an endless same-session loop: after every final answer, the loop injects a user-configurable continuation prompt, retries with exponential backoff on any failure, and re-enables 80% auto-compaction plus the /compact command.",
  "version": "1.0.20260903",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyza66/dsh-loop-agent.git"
  },
  "homepage": "https://github.com/tyza66/dsh-loop-agent#readme",
  "bugs": {
    "url": "https://github.com/tyza66/dsh-loop-agent/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent",
    "loop",
    "web",
    "endless",
    "compaction"
  ]
}
